{
  "name": "@ifc-boq/app",
  "version": "0.1.0",
  "private": true,
  "description": "boqlet: the product frontend (Next.js App Router). UI only; talks to the API in packages/api/openapi.yaml.",
  "scripts": {
    "i18n:pseudo": "node scripts/pseudo-locale.mjs",
    "dev": "node scripts/pseudo-locale.mjs && next dev --port 3000",
    "build": "node scripts/pseudo-locale.mjs && next build",
    "start": "next start --port 3000",
    "typecheck": "node scripts/pseudo-locale.mjs && next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/vitest.mjs",
    "ui:add": "node scripts/ui-add.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@ifc-boq/api": "*",
    "@microsoft/fetch-event-source": "2.0.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.12",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.6.3",
    "vitest": "5.1.0"
  }
}
