{
  "name": "boqlet",
  "private": true,
  "version": "0.1.0",
  "description": "boqlet: IFC -> Bill of Quantities. Product root (P44): PoC web app + Python engine today, the product apps and services as they are built.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests"
  ],
  "scripts": {
    "postinstall": "node scripts/setup-engine.mjs",
    "setup:engine": "node scripts/setup-engine.mjs --force",
    "dev:poc": "concurrently -k -n engine,web -c blue,green \"npm:dev:engine\" \"npm:dev:web\"",
    "dev:app": "concurrently -k -n engine,mock,app -c blue,magenta,green \"npm:dev:engine\" \"npm:dev:mock\" \"npm run dev -w @ifc-boq/app\"",
    "dev:mock": "npm run dev -w @ifc-boq/mock-api",
    "mock:seed": "npm run seed -w @ifc-boq/mock-api",
    "mock:reset": "npm run reset -w @ifc-boq/mock-api",
    "dev:engine": "node scripts/run-engine.mjs serve",
    "dev:web": "npm run dev -w @ifc-boq/web",
    "build:poc": "npm run build -w @ifc-boq/web",
    "build:app": "npm run build -w @ifc-boq/app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @ifc-boq/app",
    "test:app": "npm run test -w @ifc-boq/app",
    "test:mock": "npm run test -w @ifc-boq/mock-api",
    "test:contract": "npm run contract -w @ifc-boq/tests",
    "test:scenarios": "npm run scenarios -w @ifc-boq/tests",
    "test:contract:mock": "npm run contract:mock -w @ifc-boq/tests",
    "test:scenarios:mock": "npm run scenarios:mock -w @ifc-boq/tests",
    "e2e:app": "npm run e2e -w @ifc-boq/app",
    "test": "npm run typecheck && npm run lint && npm run test:app && npm run test:mock && npm run test:contract:mock && npm run test:scenarios:mock && npm run test:engine",
    "test:engine": "node scripts/run-engine.mjs test",
    "boq": "node scripts/run-engine.mjs cli",
    "corpus": "node scripts/run-engine.mjs corpus",
    "catalogue": "node scripts/run-engine.mjs catalogue",
    "codegen": "npm run codegen -w @ifc-boq/types",
    "import:uniclass": "node scripts/run-engine.mjs import-uniclass",
    "api:lint": "redocly lint packages/api/openapi.yaml packages/pricing-api/openapi-pricing.yaml --config packages/api/redocly.yaml",
    "api:gen": "node scripts/api-codegen.mjs",
    "api:check": "node scripts/api-codegen.mjs --check"
  },
  "devDependencies": {
    "@redocly/cli": "2.77.0",
    "concurrently": "^9.2.5",
    "openapi-typescript": "7.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
