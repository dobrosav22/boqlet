{
  "name": "@ifc-boq/api",
  "version": "0.1.0",
  "private": true,
  "description": "The core HTTP contract (openapi.yaml) and its generated client. Frontend, mock API and Java backend all implement or consume exactly this file.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts",
    "./openapi.yaml": "./openapi.yaml",
    "./spec": "./src/node/spec.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@redocly/openapi-core": "2.77.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0"
  }
}
