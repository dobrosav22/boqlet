{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/OurRuleType",
  "definitions": {
    "OurRuleType": {
      "anyOf": [
        {
          "$ref": "#/definitions/RuleSet"
        },
        {
          "$ref": "#/definitions/RuleSetPatch"
        }
      ]
    },
    "RuleSet": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/definitions/RuleSetMeta"
        },
        "defaults": {
          "$ref": "#/definitions/RuleSetDefaults"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Param"
          },
          "description": "The slots. A standard is mostly a set of values for these."
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RuleSection"
          },
          "description": "How the slots are grouped into questions (settings questionnaire), in order."
        },
        "scope": {
          "$ref": "#/definitions/RuleScope",
          "description": "What the BoQ covers (elements left out)."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemRule"
          }
        },
        "derived": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DerivedRule"
          }
        },
        "manual": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ManualItem"
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "name",
        "version",
        "meta",
        "params",
        "items"
      ],
      "additionalProperties": false,
      "description": "OurRuleType: a complete, self-contained rule set."
    },
    "RuleSetMeta": {
      "type": "object",
      "properties": {
        "basedOn": {
          "type": "string",
          "description": "Free text, e.g. \"Based on our reading of NRM2\". Not a compliance claim."
        },
        "author": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "unitSystem": {
          "type": "string",
          "enum": [
            "metric",
            "imperial"
          ]
        },
        "description": {
          "type": "string"
        },
        "chain": {
          "type": "string",
          "description": "Set by the engine on flattened snapshots: \"as-modelled -> demo-tweaked\"."
        }
      },
      "required": [
        "unitSystem"
      ],
      "additionalProperties": false
    },
    "RuleSetDefaults": {
      "type": "object",
      "properties": {
        "rounding": {
          "$ref": "#/definitions/Rounding"
        },
        "onMissing": {
          "$ref": "#/definitions/OnMissing"
        },
        "breakdown": {
          "$ref": "#/definitions/Breakdown"
        }
      },
      "additionalProperties": false
    },
    "Rounding": {
      "type": "object",
      "properties": {
        "step": {
          "$ref": "#/definitions/Value%3Cnumber%3E"
        },
        "mode": {
          "$ref": "#/definitions/Value%3C(%22nearest%22%7C%22up%22%7C%22down%22)%3E"
        },
        "at": {
          "$ref": "#/definitions/Value%3C(%22element%22%7C%22line%22)%3E",
          "description": "Round each element before summing, or the summed line."
        }
      },
      "required": [
        "step",
        "mode",
        "at"
      ],
      "additionalProperties": false
    },
    "Value<number>": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/definitions/ParamRef"
        }
      ],
      "description": "A literal value, or a slot to be filled from `params`."
    },
    "ParamRef": {
      "type": "object",
      "properties": {
        "param": {
          "type": "string"
        }
      },
      "required": [
        "param"
      ],
      "additionalProperties": false,
      "description": "Reference to a named parameter in `RuleSet.params`."
    },
    "Value<(\"nearest\"|\"up\"|\"down\")>": {
      "anyOf": [
        {
          "type": "string",
          "const": "nearest"
        },
        {
          "type": "string",
          "const": "up"
        },
        {
          "type": "string",
          "const": "down"
        },
        {
          "$ref": "#/definitions/ParamRef"
        }
      ],
      "description": "A literal value, or a slot to be filled from `params`."
    },
    "Value<(\"element\"|\"line\")>": {
      "anyOf": [
        {
          "type": "string",
          "const": "element"
        },
        {
          "type": "string",
          "const": "line"
        },
        {
          "$ref": "#/definitions/ParamRef"
        }
      ],
      "description": "A literal value, or a slot to be filled from `params`."
    },
    "OnMissing": {
      "anyOf": [
        {
          "type": "string",
          "const": "flag"
        },
        {
          "type": "string",
          "const": "skip"
        },
        {
          "type": "string",
          "const": "ask"
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "$ref": "#/definitions/Value%3Cnumber%3E"
            }
          },
          "required": [
            "default"
          ],
          "additionalProperties": false
        }
      ],
      "description": "What happens when a needed value is missing on an element."
    },
    "Breakdown": {
      "type": "string",
      "enum": [
        "element",
        "layer",
        "face",
        "material",
        "child"
      ],
      "description": "What one rule produces lines from."
    },
    "Param": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "$ref": "#/definitions/Unit"
            },
            "min": {
              "type": "number",
              "description": "Allowed range of the answer; Check reports an answer outside it."
            },
            "max": {
              "type": "number"
            },
            "label": {
              "type": "string",
              "description": "Short name, used in tables and next to fields bound to the slot."
            },
            "section": {
              "type": "string",
              "description": "`RuleSet.sections[].id` this slot is asked in."
            },
            "question": {
              "type": "string",
              "description": "The question as a person reading their rulebook would answer it."
            },
            "help": {
              "type": "string"
            },
            "example": {
              "type": "string",
              "description": "A worked example, e.g. \"A 10 m2 wall with a 0.6 m2 window: …\"."
            },
            "dependsOn": {
              "type": "object",
              "properties": {
                "param": {
                  "type": "string"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              },
              "required": [
                "param",
                "values"
              ],
              "additionalProperties": false,
              "description": "Only relevant when another slot has one of these values (the questionnaire dims it otherwise)."
            }
          },
          "required": [
            "label",
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "choice"
            },
            "value": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "optionLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Readable text per option, e.g. { volume_from_thickness: \"m3 from a thickness, m2 below\" }."
            },
            "label": {
              "type": "string",
              "description": "Short name, used in tables and next to fields bound to the slot."
            },
            "section": {
              "type": "string",
              "description": "`RuleSet.sections[].id` this slot is asked in."
            },
            "question": {
              "type": "string",
              "description": "The question as a person reading their rulebook would answer it."
            },
            "help": {
              "type": "string"
            },
            "example": {
              "type": "string",
              "description": "A worked example, e.g. \"A 10 m2 wall with a 0.6 m2 window: …\"."
            },
            "dependsOn": {
              "type": "object",
              "properties": {
                "param": {
                  "type": "string"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              },
              "required": [
                "param",
                "values"
              ],
              "additionalProperties": false,
              "description": "Only relevant when another slot has one of these values (the questionnaire dims it otherwise)."
            }
          },
          "required": [
            "label",
            "options",
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "description": "Short name, used in tables and next to fields bound to the slot."
            },
            "section": {
              "type": "string",
              "description": "`RuleSet.sections[].id` this slot is asked in."
            },
            "question": {
              "type": "string",
              "description": "The question as a person reading their rulebook would answer it."
            },
            "help": {
              "type": "string"
            },
            "example": {
              "type": "string",
              "description": "A worked example, e.g. \"A 10 m2 wall with a 0.6 m2 window: …\"."
            },
            "dependsOn": {
              "type": "object",
              "properties": {
                "param": {
                  "type": "string"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              },
              "required": [
                "param",
                "values"
              ],
              "additionalProperties": false,
              "description": "Only relevant when another slot has one of these values (the questionnaire dims it otherwise)."
            }
          },
          "required": [
            "label",
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string"
            },
            "label": {
              "type": "string",
              "description": "Short name, used in tables and next to fields bound to the slot."
            },
            "section": {
              "type": "string",
              "description": "`RuleSet.sections[].id` this slot is asked in."
            },
            "question": {
              "type": "string",
              "description": "The question as a person reading their rulebook would answer it."
            },
            "help": {
              "type": "string"
            },
            "example": {
              "type": "string",
              "description": "A worked example, e.g. \"A 10 m2 wall with a 0.6 m2 window: …\"."
            },
            "dependsOn": {
              "type": "object",
              "properties": {
                "param": {
                  "type": "string"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              },
              "required": [
                "param",
                "values"
              ],
              "additionalProperties": false,
              "description": "Only relevant when another slot has one of these values (the questionnaire dims it otherwise)."
            }
          },
          "required": [
            "label",
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "formula"
            },
            "value": {
              "$ref": "#/definitions/Expr"
            },
            "unit": {
              "$ref": "#/definitions/Unit"
            },
            "variables": {
              "type": "string",
              "description": "What the formula can use, e.g. \"src.* = the wall's measured fields\"."
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/definitions/Expr"
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              },
              "description": "Ready-made answers offered as a pick list (\"both faces\", \"one face\"). Picking one copies its formula into `value`; the formula stays visible and editable, and an edited one is \"custom\". Presentation only: the engine reads `value`."
            },
            "label": {
              "type": "string",
              "description": "Short name, used in tables and next to fields bound to the slot."
            },
            "section": {
              "type": "string",
              "description": "`RuleSet.sections[].id` this slot is asked in."
            },
            "question": {
              "type": "string",
              "description": "The question as a person reading their rulebook would answer it."
            },
            "help": {
              "type": "string"
            },
            "example": {
              "type": "string",
              "description": "A worked example, e.g. \"A 10 m2 wall with a 0.6 m2 window: …\"."
            },
            "dependsOn": {
              "type": "object",
              "properties": {
                "param": {
                  "type": "string"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              },
              "required": [
                "param",
                "values"
              ],
              "additionalProperties": false,
              "description": "Only relevant when another slot has one of these values (the questionnaire dims it otherwise)."
            }
          },
          "required": [
            "label",
            "type",
            "value"
          ]
        }
      ],
      "description": "A named, editable slot. This is what a standard \"fills in\"."
    },
    "Unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "enum": [
            "nr",
            "item",
            "sum",
            "mm",
            "m",
            "km",
            "m2",
            "m3",
            "kg",
            "t",
            "ft",
            "ft2",
            "ft3",
            "yd2",
            "yd3",
            "lb",
            "h"
          ]
        }
      ]
    },
    "Expr": {
      "type": "string",
      "description": "A formula in the small, safe expression language.\n\nGrammar (evaluated only by the engine, never by `eval`):   literals      12  0.5  \"text\"  true  false   operators     + - * /  ( )  = != > >= < <=  AND OR NOT   functions     IF(c,a,b)  MIN(a,b,..)  MAX(a,b,..)  ROUND(x,step)  CEIL(x,step)                 FLOOR(x,step)  ABS(x)  SQRT(x)  PI()  COALESCE(a,b,..)                 UNDER(term, \"concrete\")   true if a dictionary term is that term or beneath it   variables     any MeasuredField           e.g. net_area, thickness, length                 props[\"Pset_WallCommon.FireRating\"]                 p.<param>                   e.g. p.opening_threshold                 building.<field>            whole-building values (BuildingMeasures), e.g. building.gross_volume                 src.<field> / src.qty       (derived rules only: the source element / line)   aggregates    SUM | COUNT | MIN | MAX | AVG over a collection, with optional WHERE:                   SUM(openings.area WHERE area > p.opening_threshold)                   SUM(layers.volume WHERE material = \"concrete\")                   COUNT(openings WHERE kind = \"door\")                   SUM(faces.net_area WHERE side = \"a\")                 collections: openings, layers, faces, children"
    },
    "RuleSection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "description": "A group of questions in the settings questionnaire, in display order."
    },
    "RuleScope": {
      "type": "object",
      "properties": {
        "exclude": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Selector"
          }
        }
      },
      "additionalProperties": false,
      "description": "What a BoQ covers. Elements matching any `exclude` condition are left out: not measured, not asked about, counted in the log (e.g. existing and demolished elements in a renovation BoQ). Items with `scope: \"out\"` measure exactly those."
    },
    "Selector": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Selector"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Selector"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/definitions/Selector"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "$ref": "#/definitions/SelectorField"
            },
            "op": {
              "$ref": "#/definitions/SelectorOp"
            },
            "value": {
              "$ref": "#/definitions/Value%3Cunknown%3E"
            }
          },
          "required": [
            "field",
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "family": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ElementFamily"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ElementFamily"
                  }
                }
              ]
            }
          },
          "required": [
            "family"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ifcClass": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": [
            "ifcClass"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "expr": {
              "$ref": "#/definitions/Expr"
            }
          },
          "required": [
            "expr"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SelectorField": {
      "anyOf": [
        {
          "$ref": "#/definitions/MeasuredField"
        },
        {
          "type": "string",
          "const": "ifc_class"
        },
        {
          "type": "string",
          "const": "predefined_type"
        },
        {
          "type": "string",
          "const": "type_name"
        },
        {
          "type": "string",
          "const": "family"
        },
        {
          "type": "string",
          "const": "family_name"
        },
        {
          "type": "string",
          "const": "material"
        },
        {
          "type": "string",
          "const": "element_type"
        },
        {
          "type": "string",
          "const": "space_type"
        },
        {
          "type": "string",
          "const": "discipline"
        },
        {
          "type": "string",
          "const": "storey"
        },
        {
          "type": "string",
          "const": "space"
        },
        {
          "type": "string",
          "const": "zone"
        },
        {
          "type": "string",
          "const": "status"
        },
        {
          "type": "string",
          "const": "is_external"
        },
        {
          "type": "string",
          "const": "load_bearing"
        },
        {
          "type": "string",
          "const": "system"
        },
        {
          "type": "string",
          "const": "profile"
        },
        {
          "type": "string",
          "const": "nominal_size"
        },
        {
          "type": "string",
          "const": "tag"
        },
        {
          "type": "string"
        }
      ]
    },
    "MeasuredField": {
      "type": "string",
      "enum": [
        "storey_elevation",
        "length",
        "width",
        "height",
        "thickness",
        "depth",
        "diameter",
        "cross_section_area",
        "slope",
        "elevation_base",
        "elevation_top",
        "profile_girth",
        "gross_area",
        "net_area",
        "footprint_area",
        "developed_area",
        "floor_area",
        "ceiling_area",
        "wall_area",
        "wall_area_net",
        "skirting_length",
        "gross_volume",
        "net_volume",
        "perimeter",
        "mass",
        "nominal_mass_per_length",
        "density",
        "bar_diameter",
        "bar_count",
        "bar_length",
        "insulation_thickness",
        "connection_count"
      ],
      "description": "Numeric fields rules may use as variables in formulas, selectors and bands. Written out explicitly so the JSON Schema (for the Python engine) can list them; the check below fails to compile if this list drifts from MeasuredElement."
    },
    "SelectorOp": {
      "type": "string",
      "enum": [
        "eq",
        "neq",
        "in",
        "not_in",
        "gt",
        "gte",
        "lt",
        "lte",
        "between",
        "contains",
        "starts_with",
        "matches",
        "exists",
        "missing",
        "under"
      ]
    },
    "Value<unknown>": {
      "anyOf": [
        {},
        {
          "$ref": "#/definitions/ParamRef"
        }
      ],
      "description": "A literal value, or a slot to be filled from `params`."
    },
    "ElementFamily": {
      "type": "string",
      "enum": [
        "linear",
        "planar",
        "volumetric",
        "countable",
        "reinforcement",
        "assembly",
        "space",
        "void"
      ]
    },
    "ItemRule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "family": {
          "anyOf": [
            {
              "$ref": "#/definitions/ElementFamily"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ElementFamily"
              }
            }
          ],
          "description": "Informative; also lets the editor offer only valid quantity kinds."
        },
        "match": {
          "$ref": "#/definitions/Selector",
          "description": "Which elements (or parts) this rule takes."
        },
        "parts": {
          "type": "string",
          "enum": [
            "skip",
            "include"
          ],
          "description": "Elements that are parts of an aggregate (a roof's slab, a stair's flights and railings) are skipped by default when some enabled rule measures the parent, to avoid counting twice. \"include\" measures them anyway (e.g. stair railings)."
        },
