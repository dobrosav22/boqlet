{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FederationSettings",
  "definitions": {
    "FederationSettings": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "disciplines": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "owns": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Selector"
                }
              },
              "rest": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "description": "What each discipline provides by default. `owns`: selectors over MeasuredElement. `rest`: owns whatever no other listed discipline owns (architecture, typically). A model whose discipline is not listed owns everything in it."
        },
        "storeyTolerance": {
          "type": "number",
          "description": "Storeys of different models within this distance (m) are the same level."
        },
        "duplicateOverlap": {
          "type": "number",
          "description": "Two elements of one IFC class from different models whose bounding boxes overlap by at least this share of the smaller box are taken to be the same object (0-1)."
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "name",
        "version",
        "disciplines",
        "storeyTolerance",
        "duplicateOverlap"
      ],
      "additionalProperties": false,
      "description": "Federation settings (preset data, presets/settings/federation.json). Several models are combined into one set of elements and measured once (D43): same GlobalId kept once, each element taken from the model whose discipline owns it, overlaps between models asked."
    },
    "Selector": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Selector"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Selector"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/definitions/Selector"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "$ref": "#/definitions/SelectorField"
            },
            "op": {
              "$ref": "#/definitions/SelectorOp"
            },
            "value": {
              "$ref": "#/definitions/Value%3Cunknown%3E"
            }
          },
          "required": [
            "field",
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "family": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ElementFamily"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ElementFamily"
                  }
                }
              ]
            }
          },
          "required": [
            "family"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ifcClass": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": [
            "ifcClass"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "expr": {
              "$ref": "#/definitions/Expr"
            }
          },
          "required": [
            "expr"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SelectorField": {
      "anyOf": [
        {
          "$ref": "#/definitions/MeasuredField"
        },
        {
          "type": "string",
          "const": "ifc_class"
        },
        {
          "type": "string",
          "const": "predefined_type"
        },
        {
          "type": "string",
          "const": "type_name"
        },
        {
          "type": "string",
          "const": "family"
        },
        {
          "type": "string",
          "const": "family_name"
        },
        {
          "type": "string",
          "const": "material"
        },
        {
          "type": "string",
          "const": "element_type"
        },
        {
          "type": "string",
          "const": "space_type"
        },
        {
          "type": "string",
          "const": "discipline"
        },
        {
          "type": "string",
          "const": "storey"
        },
        {
          "type": "string",
          "const": "space"
        },
        {
          "type": "string",
          "const": "zone"
        },
        {
          "type": "string",
          "const": "status"
        },
        {
          "type": "string",
          "const": "is_external"
        },
        {
          "type": "string",
          "const": "load_bearing"
        },
        {
          "type": "string",
          "const": "system"
        },
        {
          "type": "string",
          "const": "profile"
        },
        {
          "type": "string",
          "const": "nominal_size"
        },
        {
          "type": "string",
          "const": "tag"
        },
        {
          "type": "string"
        }
      ]
    },
    "MeasuredField": {
      "type": "string",
      "enum": [
        "storey_elevation",
        "length",
        "width",
        "height",
        "thickness",
        "depth",
        "diameter",
        "cross_section_area",
        "slope",
        "elevation_base",
        "elevation_top",
        "profile_girth",
        "gross_area",
        "net_area",
        "footprint_area",
        "developed_area",
        "floor_area",
        "ceiling_area",
        "wall_area",
        "wall_area_net",
        "skirting_length",
        "gross_volume",
        "net_volume",
        "perimeter",
        "mass",
        "nominal_mass_per_length",
        "density",
        "bar_diameter",
        "bar_count",
        "bar_length",
        "insulation_thickness",
        "connection_count"
      ],
      "description": "Numeric fields rules may use as variables in formulas, selectors and bands. Written out explicitly so the JSON Schema (for the Python engine) can list them; the check below fails to compile if this list drifts from MeasuredElement."
    },
    "SelectorOp": {
      "type": "string",
      "enum": [
        "eq",
        "neq",
        "in",
        "not_in",
        "gt",
        "gte",
        "lt",
        "lte",
        "between",
        "contains",
        "starts_with",
        "matches",
        "exists",
        "missing",
        "under"
      ]
    },
    "Value<unknown>": {
      "anyOf": [
        {},
        {
          "$ref": "#/definitions/ParamRef"
        }
      ],
      "description": "A literal value, or a slot to be filled from `params`."
    },
    "ParamRef": {
      "type": "object",
      "properties": {
        "param": {
          "type": "string"
        }
      },
      "required": [
        "param"
      ],
      "additionalProperties": false,
      "description": "Reference to a named parameter in `RuleSet.params`."
    },
    "ElementFamily": {
      "type": "string",
      "enum": [
        "linear",
        "planar",
        "volumetric",
        "countable",
        "reinforcement",
        "assembly",
        "space",
        "void"
      ]
    },
    "Expr": {
      "type": "string",
      "description": "A formula in the small, safe expression language.\n\nGrammar (evaluated only by the engine, never by `eval`):   literals      12  0.5  \"text\"  true  false   operators     + - * /  ( )  = != > >= < <=  AND OR NOT   functions     IF(c,a,b)  MIN(a,b,..)  MAX(a,b,..)  ROUND(x,step)  CEIL(x,step)                 FLOOR(x,step)  ABS(x)  SQRT(x)  PI()  COALESCE(a,b,..)                 UNDER(term, \"concrete\")   true if a dictionary term is that term or beneath it   variables     any MeasuredField           e.g. net_area, thickness, length                 props[\"Pset_WallCommon.FireRating\"]                 p.<param>                   e.g. p.opening_threshold                 building.<field>            whole-building values (BuildingMeasures), e.g. building.gross_volume                 src.<field> / src.qty       (derived rules only: the source element / line)   aggregates    SUM | COUNT | MIN | MAX | AVG over a collection, with optional WHERE:                   SUM(openings.area WHERE area > p.opening_threshold)                   SUM(layers.volume WHERE material = \"concrete\")                   COUNT(openings WHERE kind = \"door\")                   SUM(faces.net_area WHERE side = \"a\")                 collections: openings, layers, faces, children"
    }
  }
}
