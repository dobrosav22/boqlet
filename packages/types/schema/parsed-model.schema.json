        },
        "authoringApp": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "vendor": {
              "type": "string"
            },
            "fullName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "originatingSystem": {
          "type": "string"
        },
        "preprocessor": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "fileTimestamp": {
          "type": "string"
        },
        "project": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "longName": {
              "type": "string"
            },
            "phase": {
              "type": "string"
            }
          },
          "required": [
