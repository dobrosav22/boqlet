          "const": "1.0"
        },
        "header": {
          "$ref": "#/definitions/Header"
        },
        "spatial": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SpatialNode"
          }
        },
        "catalogues": {
          "$ref": "#/definitions/Catalogues"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ParsedElement"
          }
        },
        "openings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ParsedOpening"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Relationship"
          }
        },
        "verification": {
          "$ref": "#/definitions/Verification"
        },
        "geometry": {
          "$ref": "#/definitions/GeometryStore"
        },
        "stats": {
          "type": "object",
          "properties": {
            "elementCount": {
              "type": "number"
            },
            "openingCount": {
              "type": "number"
            },
            "spaceCount": {
