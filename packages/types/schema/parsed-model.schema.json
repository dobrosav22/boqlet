        "ifcClass",
        "params"
      ],
      "additionalProperties": false
    },
    "SystemDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "ifcClass": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "predefinedType": {
          "type": "string"
        },
        "memberIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
