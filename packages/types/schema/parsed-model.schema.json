          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "materialId": {
                "type": "string"
              },
              "thickness": {
                "type": "number"
              },
              "isVentilated": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              }
            },
            "required": [
              "thickness"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "totalThickness",
        "layers"
      ],
      "additionalProperties": false
    },
    "Profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "ifcClass": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "area": {
          "type": "number"
        }
      },
      "required": [
