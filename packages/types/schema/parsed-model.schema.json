          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "ParsedElement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "stepId": {
          "type": "number"
        },
        "ifcClass": {
          "type": "string"
        },
        "ifcClassBase": {
          "type": "string"
        },
        "predefinedType": {
          "type": "string"
        },
        "objectType": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "typeId": {
          "type": "string"
        },
        "containerId": {
          "type": "string"
        },
        "storeyId": {
          "type": "string"
        },
        "parentId": {
          "type": "string"
        },
        "childIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hostId": {
          "type": "string"
        },
        "openingIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fillsOpeningId": {
          "type": "string"
        },
        "systemIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "materialRef": {
          "$ref": "#/definitions/MaterialRef"
        },
        "classificationIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Scalar"
          },
          "description": "Direct IFC attributes worth keeping, e.g. OverallWidth / OverallHeight on doors."
        },
        "psets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/PropValue"
            }
          }
        },
        "typePsets": {
          "type": "object",
          "additionalProperties": {
