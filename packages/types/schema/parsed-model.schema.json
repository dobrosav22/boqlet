        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            },
            "materialIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "materialIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "layerSet"
            },
            "layerSetId": {
              "type": "string"
            },
            "direction": {
              "type": "string",
              "enum": [
                "AXIS1",
                "AXIS2",
                "AXIS3"
              ]
            },
            "sense": {
              "type": "string",
              "enum": [
                "POSITIVE",
                "NEGATIVE"
              ]
            },
            "offset": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "layerSetId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "profileSet"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "materialId": {
                    "type": "string"
                  },
                  "profileId": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "constituentSet"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "materialId": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "fraction": {
                    "type": "number"
                  },
                  "category": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false
        }
      ],
      "description": "How an element's material is defined. Mirrors IFC's material options."
    },
    "Material": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "psets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
