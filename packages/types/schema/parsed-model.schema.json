              }
            }
          },
          "required": [
            "elementCount",
            "openingCount",
            "spaceCount",
            "byClass"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "header",
        "spatial",
        "catalogues",
        "elements",
        "openings",
        "relationships",
        "verification",
        "stats"
      ],
      "additionalProperties": false
    },
    "Header": {
