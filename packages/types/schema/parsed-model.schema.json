          "additionalProperties": false
        },
        "georeference": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number"
            },
            "longitude": {
              "type": "number"
            },
            "elevation": {
              "type": "number"
            },
            "trueNorthDeg": {
              "type": "number"
            },
            "crs": {
              "type": "string"
            },
            "mapConversion": {
              "type": "object",
              "properties": {
                "eastings": {
                  "type": "number"
                },
                "northings": {
                  "type": "number"
                },
                "orthogonalHeight": {
                  "type": "number"
                },
                "rotationDeg": {
                  "type": "number"
                },
                "scale": {
                  "type": "number"
                }
              },
              "required": [
                "eastings",
                "northings",
                "orthogonalHeight"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "disciplineGuess": {
          "type": "string",
          "enum": [
            "architecture",
            "structure",
            "mep",
            "infrastructure",
            "mixed",
            "unknown"
          ],
          "description": "Engine's guess; the user confirms it when adding the model to a project."
        },
        "parse": {
          "type": "object",
          "properties": {
            "engineVersion": {
              "type": "string"
            },
            "ifcopenshellVersion": {
              "type": "string"
            },
            "parsedAt": {
              "type": "string"
            },
            "durationMs": {
              "type": "number"
            }
          },
          "required": [
            "engineVersion",
            "parsedAt",
            "durationMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source",
        "ifcSchema",
        "project",
        "units",
        "parse"
      ],
      "additionalProperties": false
    },
    "SpatialNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "project",
            "site",
            "building",
            "storey",
            "space",
            "zone",
            "facility",
            "facility_part"
          ]
        },
        "ifcClass": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "longName": {
          "type": "string"
        },
        "parentId": {
          "type": "string",
          "description": "Parent in the spatial tree (zones have none; see memberIds)."
        },
        "childIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elevation": {
          "type": "number"
        },
        "memberIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Zones group spaces."
        },
        "predefinedType": {
          "type": "string"
        },
        "psets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/PropValue"
            }
          }
        },
        "quantities": {
          "$ref": "#/definitions/ReportedQuantities"
        },
        "geometry": {
          "$ref": "#/definitions/GeometryInfo"
        }
      },
      "required": [
        "id",
        "kind",
        "ifcClass",
        "childIds",
        "psets",
        "quantities"
      ],
      "additionalProperties": false
    },
    "PropValue": {
      "anyOf": [
        {
          "$ref": "#/definitions/Scalar"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Scalar"
          }
        }
      ]
    },
    "Scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ],
      "description": "ParsedModel — the reusable JSON produced from one IFC file (one model version).\n\nLayer 1 of 2:   ParsedModel       faithful snapshot of the IFC. No decisions, no dictionary,                     no adopted quantities. Reused by the rules pipeline, the 3D                     viewer, revision comparison, review questions and federation.   MeasuredElement   (measured.ts) derived FROM this, with names normalised and                     quantities adopted. Cheap to recompute; this layer is not.\n\nConventions   - Ids are IFC GlobalIds wherever the IFC has one (stable across versions,     used to match elements between revisions). Catalogue entries without a     GlobalId (materials, layer sets) get a deterministic id \"mat:<step id>\".   - All lengths, areas, volumes are converted to SI (m, m2, m3). The original     unit is recorded in `header.units`.   - Coordinates are world coordinates of the file (before any federation     alignment, which is a separate step).   - Heavy geometry (meshes) is NOT in this JSON. Elements point into a     separate geometry store (e.g. a .glb with one node per GlobalId)."
    },
    "ReportedQuantities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        }
      },
      "description": "Quantity sets exactly as reported in the file (BaseQuantities, Qto_*, authoring-tool sets)."
    },
    "GeometryInfo": {
      "type": "object",
      "properties": {
        "representationTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IFC representation types found, e.g. [\"SweptSolid\"], [\"Brep\"], [\"SurfaceModel\"]."
        },
        "hasBody": {
          "type": "boolean"
        },
        "meshRef": {
          "type": "string",
          "description": "Node / object id in the geometry store, normally the GlobalId."
        },
        "bboxMin": {
          "$ref": "#/definitions/Vec3"
        },
        "bboxMax": {
          "$ref": "#/definitions/Vec3"
        },
        "centroid": {
          "$ref": "#/definitions/Vec3"
        },
        "volume": {
          "type": "number"
        },
        "surfaceArea": {
          "type": "number"
        },
        "triangleCount": {
          "type": "number"
        },
        "watertight": {
          "type": "boolean",
          "description": "Every mesh edge is shared by exactly two triangles."
        },
        "closed": {
          "type": "boolean",
          "description": "The surface encloses a volume: watertight, or geometrically closed although the triangulation has T-junctions (area-weighted normals sum to ~0). The geometric volume is trusted only when this is true."
        },
        "obbExtents": {
          "$ref": "#/definitions/Vec3",
          "description": "Oriented bounding box: extents in metres, largest first, and the unit axis of each. Unlike bboxMin/bboxMax it does not depend on world axes (rotated walls, sloped members)."
        },
        "obbAxes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Vec3"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "bodyCount": {
          "type": "number",
          "description": "Disjoint pieces in the mesh, when more than one; the oriented box then describes the largest."
        },
        "sides": {
          "type": "object",
          "properties": {
            "axis": {
              "$ref": "#/definitions/Vec3"
            },
            "a": {
              "type": "number"
            },
            "b": {
              "type": "number"
            }
          },
          "required": [
            "axis",
            "a",
            "b"
          ],
          "additionalProperties": false,
          "description": "Planar elements (walls, slabs, coverings, plates): area of the mesh faces on each side of the thin axis, openings already cut. `a` faces along `axis` (up for slabs), `b` against it."
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "spaceId": {
                "type": "string"
              },
              "side": {
                "type": "string",
                "enum": [
                  "a",
                  "b"
                ]
              },
              "area": {
                "type": "number"
              }
            },
            "required": [
              "spaceId",
              "side",
              "area"
            ],
            "additionalProperties": false
          },
          "description": "Where a room's surface lies on a side of this element: contact area per space (m2)."
        },
        "room": {
          "type": "object",
          "properties": {
            "floorArea": {
              "type": "number"
            },
            "ceilingArea": {
              "type": "number"
            },
            "wallArea": {
              "type": "number"
            },
            "perimeter": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "floorArea",
            "ceilingArea",
            "wallArea",
            "perimeter",
            "height"
          ],
          "additionalProperties": false,
          "description": "Spaces: the surfaces of the room solid (m2, m)."
        },
        "normalsRepaired": {
          "type": "boolean",
          "description": "Face winding was inconsistent and repaired before measuring."
        },
        "volumeBeforeRepair": {
          "type": "number"
        },
        "error": {
          "type": "string",
          "description": "Set when geometry could not be generated."
        }
      },
      "required": [
        "representationTypes",
        "hasBody"
      ],
      "additionalProperties": false,
      "description": "Measured from the actual geometry by the engine. Independent of reported values."
    },
    "Vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "Catalogues": {
      "type": "object",
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TypeObject"
          }
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Material"
          }
        },
        "layerSets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LayerSet"
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Profile"
          }
        },
        "systems": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SystemDef"
          }
        },
        "classifications": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClassificationRef"
          }
        }
      },
      "required": [
        "types",
        "materials",
        "layerSets",
        "profiles",
        "systems",
        "classifications"
      ],
      "additionalProperties": false
    },
    "TypeObject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "ifcClass": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "predefinedType": {
          "type": "string"
        },
        "elementType": {
          "type": "string"
        },
        "psets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/PropValue"
            }
          }
        },
        "materialRef": {
          "$ref": "#/definitions/MaterialRef"
        },
        "instanceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "ifcClass",
        "psets",
        "instanceIds"
      ],
      "additionalProperties": false
    },
    "MaterialRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "single"
            },
            "materialId": {
              "type": "string"
            }
