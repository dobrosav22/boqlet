          ],
          "additionalProperties": false
        },
        "units": {
          "type": "object",
          "properties": {
            "length": {
              "type": "string"
            },
            "area": {
              "type": "string"
            },
            "volume": {
              "type": "string"
            },
            "angle": {
              "type": "string"
            },
            "mass": {
              "type": "string"
            },
            "lengthToMetre": {
