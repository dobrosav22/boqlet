  "extractors": [
    {
      "id": "revit-name",
      "field": "name",
      "regex": "^(?<family>[^:]+):(?<type>[^:]+)(?::[^:]+)*?:(?<rid>\\d+)(?::\\d+)?$",
      "outputs": {
        "family": {
          "target": "family"
        },
        "type": {
          "target": "type_name"
        },
        "rid": {
          "target": "props.authoring_id"
        }
      },
      "note": "Revit exports names as Family:Type[:Type]:ElementId"
    },
    {
      "id": "thickness-mm",
      "field": "type_name",
      "regex": "(?<t>\\d+(?:[.,]\\d+)?)\\s?mm\\b",
      "outputs": {
        "t": {
          "target": "thickness",
          "unit": "mm"
        }
      },
      "when": "ifc_class = \"IfcWall\" OR ifc_class = \"IfcSlab\"",
      "note": "A hint only: '92mm Stud' is a stud size, not wall thickness, which is why geometry wins (override false)."
    },
    {
      "id": "thickness-cm",
      "field": [
        "type_name",
        "material"
      ],
      "regex": "(?<t>\\d+(?:[.,]\\d+)?)\\s?cm\\b",
      "outputs": {
        "t": {
          "target": "thickness",
          "unit": "cm"
        }
      }
    },
    {
      "id": "strength-class",
      "field": [
        "material",
        "layer_material",
        "type_name"
      ],
      "regex": "\\b(?<sc>C\\d{2,3}/\\d{2,3}|MB\\s?\\d{2,3}|\\d{3}\\s?MPa)\\b",
      "outputs": {
        "sc": {
          "target": "strength_class"
        }
      }
    },
    {
      "id": "steel-profile",
      "field": [
        "type_name",
        "name"
      ],
      "regex": "\\b(?<p>(W|HE[ABM]|IPE|UPN|UPE|HSS|SHS|RHS|CHS)\\s?\\d+(?:[xX×]\\d+(?:[.,]\\d+)?)*)\\b",
      "outputs": {
        "p": {
          "target": "profile"
        }
      }
    },
    {
      "id": "pipe-dn",
