{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd boqlet_v1 && IFC_BOQ_SKIP_ENGINE_SETUP=1 npm ci",
  "buildCommand": "cd boqlet_v1 && VITE_DEPLOYED=1 VITE_MAX_UPLOAD_MB=4.4 npm run build:poc",
  "outputDirectory": "boqlet_v1/apps/web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{boqlet_v1/apps/**,boqlet_v1/docs/**,boqlet_v1/fixtures/**,boqlet_v1/node_modules/**,boqlet_v1/scripts/**,boqlet_v1/engine/tests/**,boqlet_v1/engine/scripts/**,boqlet_v1/engine/.cache/**,boqlet_v1/engine/.venv/**,boqlet_v1/packages/types/src/**,boqlet_v1/presets/user/**,boqlet_v1/plan/**,boqlet_v1/tests/**,boqlet_v1/services/**,**/__pycache__/**}"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index?__path=:path*" }]
}
